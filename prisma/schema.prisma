// ─────────────────────────────────────────────────────────
// AL TOQUE CA$H — Prisma 7 schema
// ─────────────────────────────────────────────────────────

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────

/// Rol del staff interno (CMS). No se usa para clientes.
enum AdminRole {
  ADMIN
  SUPERADMIN
}

/// Tipo de documento de identidad peruano.
enum DocumentType {
  DNI /// 8 dígitos — personas naturales
  RUC /// 11 dígitos — personas jurídicas y naturales con negocio
}

/// Cómo se actualizó el tipo de cambio.
enum ExchangeRateSource {
  SBS_API  /// Actualización automática vía API externa
  MANUAL   /// Carga manual por un admin_user
}

/// Cómo se autenticó el usuario en Clerk la primera vez
enum AuthProvider {
  EMAIL
  GOOGLE
}

enum Currency {
  USD
  PEN
}

enum Bank {
  BCP
  INTERBANK
  SCOTIABANK
  BBVA
  BANCO_FALABELLA
  OTROS
}

enum TransactionStatus {
  PENDING     // creada, esperando voucher/confirmación por whatsapp
  IN_REVIEW   // voucher recibido, en verificación
  COMPLETED   // dinero abonado
  CANCELLED   // cancelada por el cliente o el admin
  REJECTED    // rechazada (ej. voucher inválido)
}

// ── Modelos ─────────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())

  /// ID del usuario en Clerk (user_xxx). Fuente de verdad de auth.
  clerkId   String   @unique

  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?

  /// Tipo de documento de identidad (DNI o RUC)
  documentType   DocumentType?

  /// Número del documento. DNI = 8 dígitos, RUC = 11 dígitos.
  documentNumber String?

  /// Proveedor con el que se registró por primera vez en Clerk
  authProvider  AuthProvider @default(EMAIL)

  /// true si el email fue verificado en Clerk
  emailVerified Boolean      @default(false)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]

  @@index([email])
  @@map("customers")
}

/// Usuario del futuro CMS de administración (staff interno).
/// También se autentica con Clerk, pero se crea por invitación, no por
/// registro público — nunca desde el flujo del sitio.
model AdminUser {
  id        String    @id @default(uuid())

  clerkId   String    @unique

  email     String    @unique
  firstName String?
  lastName  String?

  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@map("admin_users")
}

/// Cuenta bancaria del cliente para recibir el cambio de moneda.
/// Un cliente puede tener varias cuentas (una por moneda/banco).
model Account {
  id                String   @id @default(uuid())

  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currency          Currency
  bank              Bank
  accountNumber     String
  /// Código de cuenta interbancario (opcional pero recomendado)
  cci               String?
  accountHolderName String

  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      Transaction[]

  @@unique([customerId, currency, accountNumber])
  @@index([customerId])
  @@map("accounts")
}

/// Operación de cambio de moneda solicitada por un cliente.
model Transaction {
  id                String            @id @default(uuid())

  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// Moneda y monto que el cliente envía
  sentCurrency      Currency
  sentAmount        Decimal           @db.Decimal(12, 2)

  /// Moneda y monto que el cliente recibirá
  receivedCurrency  Currency
  receivedAmount    Decimal           @db.Decimal(12, 2)

  /// Tipo de cambio aplicado en el momento de la solicitud
  exchangeRate      Decimal           @db.Decimal(8, 4)

  status            TransactionStatus @default(PENDING)

  /// Indica si el monto es ≥ $10,000 (o eq. en soles) y requiere el formulario SBS
  sbsRequired       Boolean           @default(false)

  /// URL o referencia del voucher enviado (si se sube luego vía CMS)
  voucherUrl        String?

  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("transactions")
}

/// Tipo de cambio publicado para compra/venta de dólares.
/// Se crea 1-2 veces al día por el job automático o manualmente por un admin.
/// El frontend solo consume el último registro (GET /exchange-rate/latest).
model ExchangeRate {
  id        String              @id @default(uuid())

  /// S/ por USD que la casa de cambio COMPRA (cliente entrega USD, recibe soles)
  buyRate   Decimal             @db.Decimal(8, 4)

  /// S/ por USD que la casa de cambio VENDE (cliente entrega soles, recibe USD)
  sellRate  Decimal             @db.Decimal(8, 4)

  /// Fuente del dato: 'SBS_API' (automático) o 'MANUAL' (admin)
  source    ExchangeRateSource  @default(SBS_API)

  /// ID del AdminUser que lo cargó manualmente (null si es automático)
  createdBy String?

  createdAt DateTime            @default(now())

  @@index([createdAt])
  @@map("exchange_rates")
}

// ── Configuraciones globales ─────────────────────────────

/// Identificadores únicos para cada parámetro configurable del sistema.
enum SettingKey {
  EXCHANGE_RATE_BUY_MARGIN  /// Margen en soles a sumar al precio de compra del BCRP
  EXCHANGE_RATE_SELL_MARGIN /// Margen en soles a sumar al precio de venta del BCRP
  WHATSAPP_NUMBER           /// Número de teléfono de atención al cliente (formato internacional, ej: +51999999999)

  // ── Datos de contacto y presentación ────────────────────
  PHONE_NUMBER              /// Teléfono fijo o celular de contacto visible en el sitio
  ADDRESS                   /// Dirección física del local (puede ser null si no aplica)

  // ── Horarios de atención ─────────────────────────────────
  SCHEDULE_1                /// Horario de atención principal (ej: "Lun–Vie 9am–6pm")
  SCHEDULE_2                /// Horario de atención secundario (ej: "Sáb 9am–1pm")

  // ── Contenido del footer ─────────────────────────────────
  FOOTER_DESCRIPTION        /// Descripción corta que aparece en el footer del sitio
  LOGO_URL                  /// URL pública del logo de la empresa

  // ── Datos bancarios ──────────────────────────────────────
  COMPANY_BANK_ACCOUNTS     /// JSON array de CompanyBankAccount serializado; cuentas receptoras de la empresa
}

/// Tabla key-value para configuraciones del sistema administrables en caliente.
/// Permite al operador cambiar márgenes y datos de contacto sin redesplegar.
model AppSetting {
  id        String     @id @default(uuid())
  key       SettingKey @unique

  /// Siempre String; se parsea (parseFloat, etc.) según la semántica de cada clave.
  value     String

  updatedAt DateTime   @updatedAt

  @@map("app_settings")
}
